# Jira + Confluence tools — environment configuration
# Copy this file to .env (same folder) and fill in your values.
# NEVER commit .env to version control.

# Deployment: "server" (Server / Data Center, Bearer PAT) or "cloud" (Atlassian Cloud, email + API token)
ATLASSIAN_DEPLOYMENT=server

# ── JIRA ──────────────────────────────────────────────────────────────────────

# Base URL, no trailing slash. Example: https://jira.example.com or https://example.atlassian.net
JIRA_BASE_URL=https://jira.example.com

# Server/DC only. Jira: Profile → Personal Access Tokens → Create token
# Required permissions: Browse Projects, Add Comments
JIRA_PAT=your_jira_personal_access_token_here

# ── CONFLUENCE ────────────────────────────────────────────────────────────────

# Base URL, no trailing slash. Cloud URLs must end in /wiki.
# Example: https://confluence.example.com or https://example.atlassian.net/wiki
CONFLUENCE_BASE_URL=https://confluence.example.com

# Server/DC only. Jira and Confluence PATs are separate even on the same host.
# Required permissions: View Space, Edit Pages
CONFLUENCE_PAT=your_confluence_personal_access_token_here

# ── CLOUD ONLY ────────────────────────────────────────────────────────────────

# Account email and API token (https://id.atlassian.com/manage-profile/security/api-tokens).
# One token works for both Jira and Confluence.
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=your_atlassian_api_token_here

# Optional: path to a corporate CA bundle if your proxy re-signs TLS
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.pem
